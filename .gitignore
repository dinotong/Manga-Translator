# Env & secrets
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs & caches
*.log
npm-debug.log*
.eslintcache
coverage/
.vitest/

# Python sidecar (optional local-services)
__pycache__/
*.py[cod]
.venv/
venv/

# Packed builds handed to friends.
#
# Every one of these is `npm run build` plus an archiver, so committing one
# trades ~27 MB of permanent repository weight for a file anyone can recreate
# in seconds. Git keeps blobs forever, so this is easier to prevent than to
# undo. *.zip and *.crx are already covered further up with the build output.
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
