# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.output/
.wxt/
*.zip
*.crx
*.pem

# ML models & runtime (downloaded on demand / too large for git)
models/
*.onnx
*.onnx_data
*.pt
*.safetensors
*.wasm

spike/public/models/

